# Required for run_local.py when using OpenAI-compatible APIs
OPENAI_API_KEY=your_api_key_here

# Optional endpoint override for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local LightRAG source checkout used when lightrag isn't installed
LIGHTRAG_SOURCE_DIR=./data/vendor/000_LightRAG

# Optional model overrides
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIM=3072
OPENAI_SEARCH_MODEL=gpt-5

# Optional Google Programmable Search credentials
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# AIFluent / LightRAG runtime settings
WORKING_DIR=./rag_storage
OUTPUT_DIR=./output
PARSER=mineru
PARSE_METHOD=auto

# Multimodal processing toggles
ENABLE_IMAGE_PROCESSING=True
ENABLE_TABLE_PROCESSING=True
ENABLE_EQUATION_PROCESSING=True

# Batch and context tuning
MAX_CONCURRENT_FILES=1
CONTEXT_WINDOW=1
